# このファイルを .env にコピーして値を入れる（.env は git 管理外）

# スコアリングに使う Claude API キー
ANTHROPIC_API_KEY=sk-ant-...

# 本番のDB。未設定なら config.yaml の app.db_path（SQLite）を使う。
# 定期実行（GitHub Actions）と審査UIが同じデータを見るために設定する。
# 移行の手順は docs/postgres-migration.md。
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 任意: config.yaml のパスを差し替える場合
# FREMING_CONFIG=config.yaml

# 審査UIを外に出すときだけ設定する（担当者と共有する場合）。
# 手元（127.0.0.1）で serve するなら不要。両方を設定すること。
# 詳細は docs/review-ui-hosting.md
REVIEW_UI_USER=
REVIEW_UI_PASSWORD=
